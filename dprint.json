{
  "toml": {
    "lineWidth": 80,
    "indentWidth": 4
  },
  "markdown": {
    "lineWidth": 100,
    "textWrap": "always"
  },
  "excludes": [
    "**/target/**",
    "**/Cargo.lock",
    "fuzz/artifacts/**",
    "fuzz/corpus/**",
    "fuzz/coverage/**"
  ],
  "plugins": [
    "https://plugins.dprint.dev/toml-0.6.2.wasm",
    "https://plugins.dprint.dev/markdown-0.17.1.wasm",
    "https://plugins.dprint.dev/json-0.19.3.wasm"
  ]
}
